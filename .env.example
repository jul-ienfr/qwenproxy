# QwenProxy Configuration
#
# Os padrões já são otimizados para produção.
# Só descomente/altere o que você realmente precisa mudar.

# ============================================================
# Contas Qwen
# ============================================================
# Obrigatório se você não usar `npm run login` para salvar contas no banco.
# Use ';' ou ',' para separar múltiplas contas (formato: email:senha).
#QWEN_ACCOUNTS=seu-email@dominio.com:sua-senha;outro@dominio.com:senha2

# ============================================================
# API / servidor
# ============================================================
# Opcional em loopback; obrigatório se HOST não for loopback (Docker usa HOST=0.0.0.0).
# Fora de loopback, sem valor, o servidor gera uma chave e grava neste .env.
#API_KEY=

# Bind. Default de código: 127.0.0.1. Docker define HOST=0.0.0.0.
#HOST=127.0.0.1

# Sem configuração, CORS aceita apenas origens de loopback.
# Defina uma origem explícita para liberar outra UI web.
#CORS_ORIGIN=

# Porta do servidor.
#PORT=7936

# ============================================================
# Browser / RAM
# ============================================================
# true: browser invisível, consome menos RAM.
# false: browser visível, útil para debug.
#PLAYWRIGHT_HEADLESS=true

# Mantém até N contextos de browser abertos simultaneamente (o watchdog RSS
# fecha contextos idle sob pressão de memória). Contas acima do limite ficam
# em standby e abrem sob demanda.
# Padrão: 3
#PLAYWRIGHT_MAX_ACTIVE_CONTEXTS=1

# false: prepara somente a primeira conta no startup (baixo consumo de RAM/CPU).
# true: prepara todas as contas no startup.
# Padrão: false
#PLAYWRIGHT_PREPARE_ALL_ON_STARTUP=false

# Segundos sem atividade antes de um contexto Playwright idle ser fechado.
# Padrão: 300000 (5min)
#PLAYWRIGHT_IDLE_CONTEXT_TTL_MS=60000

# Diretório de dados (SQLite, chave de criptografia, perfis e logs).
# Precedência: QWEN_DATA_DIR > data/ ao lado do executável > ./data > diretório
# global do sistema. Útil para instalações standalone/portáteis.
#QWEN_DATA_DIR=/caminho/para/qwenproxy-data

# Cache de navegadores Playwright/Patchright já instalado. Use quando o Chromium
# estiver fora dos caminhos padrão (comum em binários standalone sem bundle).
#PLAYWRIGHT_BROWSERS_PATH=/caminho/para/ms-playwright

# ============================================================
# Timeouts
# ============================================================
# Os padrões já são seguros para a maioria dos casos.
# Só altere se você tiver um motivo específico.
#
# PAGE_TIMEOUT=60000
# NAVIGATION_TIMEOUT=60000
# TIME_TO_FIRST_BYTE=60000
# HEADERS_TIMEOUT=60000
# IDLE_STREAM_TIMEOUT=60000
# TOTAL_REQUEST_TIMEOUT=600000
# REASONING_MODEL_TIMEOUT=300000   # silêncio mid-stream p/ modelos thinking (5 min)
# QWEN_FIRST_CHUNK_TIMEOUT=180000  # deadline do primeiro chunk

# ============================================================
# Observabilidade
# ============================================================
# Nível do logger: debug | info | warn | error (padrão: warn).
# LOG_LEVEL=warn
# TOOLCALL_DEBUG=1 força debug completo do parser de tools.

# ============================================================
# Concorrência
# ============================================================
# Limite de streams simultâneos por conta.
# Padrão: 2
#ACCOUNT_MAX_CONCURRENT_STREAMS=2

# Tarefas assíncronas especializadas ativas por chave de API (0 = ilimitado).
# Padrão: 4
#SPECIALIZED_TASK_MAX_ACTIVE_PER_USER=4

# Tarefas assíncronas especializadas ativas por instância (0 = ilimitado).
# Padrão: 32
#SPECIALIZED_TASK_MAX_ACTIVE=32

# Deadline de uma tentativa de acquire do stream (falhas visíveis → troca de
# conta em vez de ficar preso). Padrão: 120000.
#ACQUIRE_DEADLINE_MS=120000
# Tempo máx esperando o lock do CHAT (segura durante toda a geração do stream).
# Aumente se turnos longos de reasoning com contexto grande (>120s) gerarem
# acquire_deadline/500 falsos quando o próximo request da mesma conversa chega.
# Padrão: 180000
#CHAT_LOCK_TIMEOUT_MS=180000

# Cap da fila "sem deadline" de leases (owner de thread aguardando slot).
# Padrão: 120000.
#ACCOUNT_QUEUE_WAIT_FOREVER_CAP_MS=120000

# ============================================================
# Tool calling
# ============================================================
# Máximo de tool calls emitidas por turno (proteção contra alucinação em loop
# do modelo, que às vezes emite várias tool calls seguidas sem esperar os
# resultados). 0 desativa o teto. Para workloads que criam ou escrevem múltiplos
# arquivos pesados (ex.: ADRs, código extenso, múltiplos subagentes), reduza para
# 4 ou 6 para garantir que o turno feche limpo antes de esgotar os tokens de saída
# do Qwen Web.
# Padrão: 6
#MAX_TOOL_CALLS_PER_TURN=6

# Quantas execuções idênticas de uma mesma tool call (mesmo nome + mesmos
# argumentos) são toleradas no histórico antes de injetar um lembrete no prompt
# dizendo ao modelo para parar de repetir a chamada e responder com o resultado
# já existente. Combate o loop "re-read/re-inspect" (ex.: read_file do mesmo
# arquivo a cada turno). 1 desliga o lembrete.
# Padrão: 2
#QWEN_REPEATED_TOOL_CALL_WARN=2

# ============================================================
# Chat in progress
# ============================================================
# O tool loop dispara o proximo turno <100ms apos o anterior terminar, e o
# chat upstream fica "in progress" por 2-4s. Estas janelas absorvem o settle
# retentando o MESMO chat (nunca troca de conta / replay completo).
#CHAT_IN_PROGRESS_RETRY_DELAY_MS=2000
#CHAT_IN_PROGRESS_BUSY_MS=4000
#CHAT_IN_PROGRESS_MAX_RETRIES=6
#   Orcamento de retry no MESMO chat (waits com jitter). Nenhum retry escala
#   para novo chat + replay de contexto completo; apos o orcamento o request
#   falha mantendo o binding da thread (o retry do cliente cai no chat ja resolvido).

# ============================================================
# Captcha (anti-bot)
# ============================================================
# Solver Baxia/TMD ativo por padrão; false é só desligamento de emergência.
#CAPTCHA_SOLVER_ENABLED=true
#CAPTCHA_ACCOUNT_COOLDOWN_MS=120000

# ============================================================
# Comportamentos opcionais
# ============================================================
# Apaga chats criados no Qwen ao desligar o servidor.
#DELETE_ALL_CHATS_ON_SHUTDOWN=false

# Limpeza automática de chats antigos (> 1 semana / 168h) em background após a inicialização.
# Executada silenciosamente com prioridade baixa; cede o lock imediatamente se houver requisição do usuário.
# Padrão: true | 168 horas (7 dias)
#AUTO_CLEAN_CHATS_ON_STARTUP=true
#AUTO_CLEAN_CHAT_MAX_AGE_HOURS=168
# Limpeza assíncrona em segundo plano de chats órfãos (ao trocar de conta por rate limit ou context overflow).
# 100% assíncrono (fire-and-forget), zero latência para as respostas do cliente.
# Padrão: true
#AUTO_CLEAN_ORPHAN_CHATS=true
# ============================================================
# Modo de conversa
# ============================================================
# thread (default): reutiliza o chat upstream via parent_id e envia o delta
#   do turno (latência ótima, mas herda o settle "chat_in_progress").
# temp: cria um chat temporário (chat_mode:"local") NOVO a cada request e
#   envia o histórico completo (padrão OpenAI). Zero chat_in_progress e zero
#   chats órfãos no histórico da conta, porém reenvia o contexto a cada turno.
# Override por request: header X-QwenProxy-Chat-Mode: thread|temp
#QWEN_CHAT_MODE=thread

# ============================================================
# Externalisation des gros contextes agentiques
# ============================================================
# Quand le prompt complet dépasse ce seuil ET que la requête contient des
# tools, l'historique est envoyé à Qwen sous forme de fichier texte joint au
# lieu d'être inliné dans le prompt. Évite le WAF/captcha Qwen (~128 KiB).
#QWEN_EXTERNALIZE_CONTEXT_ENABLED=true
#QWEN_EXTERNALIZE_CONTEXT_BYTES=90000
# La partie inline (dernier tour) est plafonnée à cette taille.
#QWEN_EXTERNALIZE_LIVE_PROMPT_BYTES=49152
# Cache de préfixe : réutilise le fichier Qwen déjà uploadé quand l'historique
# du tour suivant commence par le même préfixe. Seuls des hashs et les
# métadonnées du fichier sont conservés (jamais le texte). Borné par TTL + LRU.
#QWEN_EXTERNALIZE_CACHE_ENABLED=true
#QWEN_EXTERNALIZE_CACHE_TTL_SECONDS=3600
#QWEN_EXTERNALIZE_CACHE_MAX_ENTRIES=64
# ============================================================
# Per-account outbound proxy
# ============================================================
# Global fallback used by accounts without their own proxy.
# Supported: http://, https://, socks5://, socks5h://
#PROXY_URL=

# Optional bootstrap mapping (email=proxy), useful for Docker/CI.
# The CLI (`npm run proxy set <email> <url>`) is the primary management surface.
#QWEN_ACCOUNT_PROXIES=

# ============================================================
# Multi-user API keys and quotas
# ============================================================
# Optional bootstrap users: key:label[:rpm[:concurrency]], comma-separated.
# Existing keys/labels are never overwritten on restart.
# Prefer `npm run users create <label>` for normal use.
#USER_API_KEYS=sk-user-1:alice:60:2,sk-user-2:bob:120:4

# Defaults for CLI/API-created users when no per-user value is given.
# 0 = unlimited.
#USER_RATE_LIMIT_RPM=0
#USER_MAX_CONCURRENCY=0

# ============================================================
# Shared persistence / multi-instance (optional)
# ============================================================
# SQLite is the default and requires no Redis. Set DATA_SAVE_MODE=redis only
# when several instances must share accounts, users, sessions, cooldowns, daily
# usage and stored Responses API state.
#
# Every instance MUST use the same ENCRYPTION_KEY so shared encrypted account
# credentials can be decrypted everywhere. Browser profiles, Qwen auth cookies,
# personalization cache, logs and the admin audit trail stay local.
#
#DATA_SAVE_MODE=sqlite
#REDIS_URL=redis://127.0.0.1:6379
#REDIS_PREFIX=qpx
# Fail startup instead of continuing on local SQLite when Redis is down.
#REDIS_REQUIRED=false
# Cross-instance propagation window (ms).
#REDIS_SYNC_INTERVAL_MS=1000
#REDIS_CONNECT_TIMEOUT_MS=5000
#
# Seed an empty Redis from the current local SQLite database:
#   DATA_SAVE_MODE=redis REDIS_URL=redis://... npm run redis:migrate
# A ready-to-run two-instance example lives in docker-compose.redis.yml.

# ============================================================
# Runtime model mapping
# ============================================================
# Mapeia nomes de modelos usados por clientes para IDs atuais do Qwen.
# Formato: alias=qwen-id separados por vírgula; *=qwen-id define o fallback
# para modelos desconhecidos. Aliases exatos têm precedência sobre o fallback
# e IDs nativos (qwen*, wan*, z-image*) nunca são reescritos.
#
# Este valor é apenas a semente inicial. Depois do primeiro save pelo
# dashboard/API, o arquivo data/model-mappings.json passa a ser a fonte
# autoritativa e é recarregado a quente (sem reiniciar o processo).
#
# Admin API: GET|PUT|DELETE /admin/api/model-mappings
#MODEL_MAP=gpt-4o=qwen3.8-max,claude-sonnet=qwen3.8-max,*=qwen3.7-plus

# ============================================================
# Web administration dashboard
# ============================================================
# Served by the same process at http://<host>:<port>/admin.
# Sign in with API_KEY or an admin-role sk-qpx-... key. On a no-key loopback
# install the login field may be left empty.
#
# The session signing secret is generated automatically and persisted at
# data/db/.admin_session_secret (mode 0600); no env variable is required.
# Deleting that file invalidates every existing admin session.
#
# Desktop GUI auto-login (qpx gui): the webview signs in with API_KEY on
# loopback. Set QWEN_GUI_ADMIN_KEY only when it must use a different admin key
# (for example an external server started with another API_KEY). The key is
# never sent to a non-loopback HOST. QWEN_GUI_DEVTOOLS=true enables devtools.
#QWEN_GUI_ADMIN_KEY=
#QWEN_GUI_DEVTOOLS=false
#
# The Settings page can hot-apply and persist these allowlisted values:
#   QWEN_CHAT_MODE, PROXY_URL, CHAT_REQUEST_LOG, RATE_LIMIT_REQUESTS,
#   RATE_LIMIT_TOKENS, USER_RATE_LIMIT_RPM, USER_MAX_CONCURRENCY
#
# Use TLS or a trusted tunnel before exposing the dashboard beyond loopback.
# Logs shown in the browser are redacted; audit records never contain secrets.
