{
  "name": "qwenproxy-cli",
  "version": "1.6.13",
  "description": "High-performance OpenAI, Anthropic & Gemini compatible API gateway for Qwen with multi-account rotation, interactive TUI, and resilient tool calling.",
  "main": "dist/index.js",
  "bin": {
    "qpx": "bin/qwenproxy.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/tests",
    "!src/benchmarks",
    "README*.md",
    "LICENSE",
    "NOTICE",
    "docs/openapi.yaml"
  ],
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "checksums": "node scripts/checksums.mjs dist/standalone",
    "verify:checksums": "node scripts/checksums.mjs dist/standalone --verify",
    "prepack": "npm run build",
    "start": "npx tsx src/index.ts",
    "tui": "npx tsx src/tui/index.ts",
    "login": "npx tsx src/login.ts",
    "proxy": "tsx src/cli/proxy.ts",
    "users": "tsx src/cli/users.ts",
    "redis:migrate": "tsx src/cli/redis-migrate.ts",
    "sync": "npx tsx src/sync-clients.ts",
    "sync:list": "npx tsx src/sync-clients.ts list",
    "sync:restore": "npx tsx src/sync-clients.ts restore",
    "clean": "npx tsx src/clean-cache.ts",
    "clean:all": "npx tsx src/clean-cache.ts --all",
    "reset": "npx tsx src/reset-cooldowns.ts",
    "purge": "npx tsx src/delete-chats.ts",
    "test": "npm run test:mock",
    "test:mock": "node scripts/run-tests.mjs --concurrency=1",
    "test:mock:fast": "node scripts/run-tests.mjs --concurrency=2",
    "test:live": "tsx --test src/tests/concurrentChat.test.ts src/tests/agenticStress.test.ts",
    "test:stress": "npx tsx src/benchmarks/stress-test.ts",
    "test:stress:personalization": "npx tsx src/benchmarks/stress-test-personalization.ts",
    "benchmark:proxy": "npx tsx src/benchmarks/proxy-baseline.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "lint:ci": "biome lint --diagnostic-level=error src",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "keywords": [
    "qwen",
    "proxy",
    "openai",
    "anthropic",
    "claude-code",
    "codex",
    "opencode",
    "tui",
    "patchright",
    "playwright",
    "llm"
  ],
  "homepage": "https://github.com/jul-ienfr/qwenproxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jul-ienfr/qwenproxy.git"
  },
  "bugs": {
    "url": "https://github.com/jul-ienfr/qwenproxy/issues"
  },
  "author": "johngbl",
  "contributors": [
    "Pedro Farias",
    "johngbl"
  ],
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "hono": "^4.13.9",
    "patchright": "1.63.0",
    "redis": "^5.12.1",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@webviewjs/webview": "^0.6.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
